---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Notes — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="notes-page">
			<header class="page-heading">
				<p class="eyebrow">THE NOTEBOOK</p>
				<h1>Notes</h1>
				<p class="intro">Field notes on Kubernetes, cloud native tools, and the systems around them.</p>
			</header>
			<section aria-label="Published notes">
				{posts.length > 0 ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<div>
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
									</div>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">
						No notes yet. Add a <code>.md</code> file to <code>src/content/blog/</code> and it will
						appear here.
					</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.notes-page {
		width: min(100% - 2.5rem, 52rem);
		min-height: 70vh;
		padding-top: clamp(3.5rem, 8vw, 6rem);
		padding-bottom: 5rem;
	}
	.page-heading {
		margin-bottom: 2.5rem;
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}
	h1 {
		margin: 0;
		font-size: clamp(3rem, 8vw, 5rem);
		letter-spacing: -0.07em;
	}
	.intro {
		max-width: 35rem;
		margin: 0.7rem 0 0;
		color: var(--muted);
		font-size: 1.1rem;
	}
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li {
		border-top: 1px solid var(--line);
	}
	.post-list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.4rem 0;
		color: inherit;
		text-decoration: none;
	}
	.post-list h2 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
		letter-spacing: -0.02em;
	}
	.post-list p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.post-list time {
		flex: 0 0 auto;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	.empty {
		padding: 1.25rem;
		border: 1px dashed var(--line);
		border-radius: 0.4rem;
		color: var(--muted);
	}
	.empty code {
		color: var(--accent);
	}
	@media (max-width: 600px) {
		.notes-page {
			width: min(100% - 1.5rem, 52rem);
		}
		.post-list a {
			display: block;
		}
		.post-list time {
			display: inline-block;
			margin-top: 0.6rem;
		}
	}
</style>
