---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_BASE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Notes — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="notes-page">
			<header class="page-heading">
				<p class="eyebrow"><span></span> THE NOTEBOOK</p>
				<h1>Notes</h1>
				<p class="intro">Field notes on Kubernetes, cloud native tools, and the systems around them.</p>
			</header>
			<section aria-label="Published notes">
				{posts.length > 0 ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`${SITE_BASE}blog/${post.id}/`}>
									<div>
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
									</div>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">
						No notes yet. Add a <code>.md</code> file to <code>src/content/blog/</code> and it will
						appear here.
					</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.notes-page {
		width: min(100% - 2.5rem, 52rem);
		min-height: 70vh;
		padding-top: clamp(4rem, 8vw, 6.5rem);
		padding-bottom: 5rem;
	}
	.page-heading {
		margin-bottom: 2.75rem;
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 1rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	.eyebrow span {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--accent) 12%, transparent);
	}
	h1 {
		margin: 0;
		font-size: clamp(3rem, 8vw, 5rem);
		font-weight: 760;
		letter-spacing: -0.08em;
	}
	.intro {
		max-width: 35rem;
		margin: 0.85rem 0 0;
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.75;
	}
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li {
		margin-top: 0.75rem;
	}
	.post-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.25rem 1.35rem;
		border: 1px solid var(--line);
		border-radius: 0.85rem;
		background: var(--panel);
		color: inherit;
		text-decoration: none;
	}
	.post-list a:hover {
		border-color: color-mix(in srgb, var(--accent) 42%, var(--line));
		box-shadow: 0 0.8rem 2rem rgb(30 48 78 / 7%);
		transform: translateY(-2px);
	}
	.post-list h2 {
		margin: 0 0 0.3rem;
		font-size: 1.12rem;
		letter-spacing: -0.02em;
	}
	.post-list p {
		margin: 0;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.post-list time {
		flex: 0 0 auto;
		color: var(--muted);
		font-size: 0.78rem;
	}
	.empty {
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.85rem;
		background: var(--panel);
		color: var(--muted);
	}
	.empty code {
		color: var(--accent);
	}
	@media (max-width: 600px) {
		.notes-page {
			width: min(100% - 1.5rem, 52rem);
		}
		.post-list a {
			display: block;
			padding: 1rem;
		}
		.post-list time {
			display: inline-block;
			margin-top: 0.6rem;
		}
	}
</style>
