---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<p class="eyebrow">ABOUT THIS PROJECT</p>
			<h1>A notebook for the cloud native world.</h1>
			<p>
				kubenotes is a home for practical notes on Kubernetes, cloud native tools, and the systems
				around them. Each article is a Markdown file, so the writing stays portable, versioned, and
				easy to update.
			</p>
			<p>
				Want to add a note? Create a <code>.md</code> file in <code>src/content/blog/</code> with a
				title, description, and publication date in its frontmatter.
			</p>
			<a href={`${SITE_BASE}blog/`}>Browse the notes <span aria-hidden="true">→</span></a>
		</main>
		<Footer />
	</body>
</html>
<style>
	.about-page {
		width: min(100% - 2.5rem, 48rem);
		min-height: 70vh;
		padding-top: clamp(4rem, 10vw, 7rem);
		padding-bottom: 6rem;
		color: var(--muted);
		font-size: 1.1rem;
		line-height: 1.8;
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	h1 {
		max-width: 42rem;
		margin: 0 0 1.4rem;
		color: var(--ink);
		font-size: clamp(2.6rem, 7vw, 4.5rem);
		font-weight: 760;
		letter-spacing: -0.075em;
		line-height: 1.05;
	}
	.about-page p:not(.eyebrow) {
		max-width: 43rem;
	}
	code {
		padding: 0.15rem 0.35rem;
		border: 1px solid var(--line);
		border-radius: 0.35rem;
		background: var(--panel);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
	a {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		margin-top: 0.5rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--accent);
		border-radius: 0.7rem;
		background: var(--accent);
		color: var(--button-text);
		font-weight: 650;
		text-decoration: none;
	}
	a:hover {
		background: var(--accent-bright);
		color: var(--button-text);
		transform: translateY(-2px);
	}
	@media (max-width: 600px) {
		.about-page {
			width: min(100% - 1.5rem, 48rem);
		}
	}
</style>
