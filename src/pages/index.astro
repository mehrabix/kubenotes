---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — cloud native field notes`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="intro">
				<div class="intro-copy">
					<p class="eyebrow"><span></span> FIELD NOTES FOR THE CLOUD NATIVE WORLD</p>
					<h1>Less noise.<br /><span>More signal.</span></h1>
					<p class="lede">
						A practical notebook for Kubernetes, cloud native tools, and the lessons learned running
						systems in production.
					</p>
					<a class="button" href={`${SITE_BASE}blog/`}>
						Explore the notes
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<path d="M4 10h11m-4-4 4 4-4 4" />
						</svg>
					</a>
					<p class="hero-caption">Practical guides <span></span> Markdown-first</p>
				</div>
				<div class="terminal" aria-label="A preview of kubenotes command-line examples">
					<div class="terminal-bar">
						<span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="terminal-title">cluster-notes.sh</span>
						<span class="terminal-badge">FIELD GUIDE</span>
					</div>
					<div class="terminal-code">
						<p><span class="line-number">01</span> <span class="prompt">$</span> kubectl get pods -A</p>
						<p><span class="line-number">02</span> <span class="comment"># check workloads across namespaces</span></p>
						<p><span class="line-number">03</span> <span class="prompt">$</span> kubectl get nodes</p>
						<p><span class="line-number">04</span> <span class="comment"># start with the whole cluster</span></p>
						<p><span class="line-number">05</span> <span class="prompt">$</span> kubectl describe deploy api</p>
					</div>
					<div class="terminal-footer"><span></span> A good investigation starts with a clear signal.</div>
				</div>
			</section>

			<section class="recent" aria-labelledby="recent-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">THE NOTEBOOK</p>
						<h2 id="recent-heading">Recent notes</h2>
					</div>
					<a href={`${SITE_BASE}blog/`}>All notes <span aria-hidden="true">→</span></a>
				</div>
				{posts.length > 0 ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`${SITE_BASE}blog/${post.id}/`}>
									<div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">
						The notebook is ready. Add a Markdown file in <code>src/content/blog/</code> to publish
						the first note.
					</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.home {
		width: min(100% - 3rem, 74rem);
		padding-top: clamp(4rem, 8vw, 7rem);
		padding-bottom: clamp(3rem, 6vw, 5.5rem);
	}
	.intro {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
		align-items: center;
		gap: clamp(2.5rem, 6vw, 6rem);
		min-height: 31rem;
		padding-bottom: clamp(4rem, 8vw, 6.5rem);
	}
	.intro::before {
		position: absolute;
		z-index: -1;
		top: -2rem;
		right: 0;
		width: min(54vw, 38rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, var(--soft) 0%, transparent 68%);
		content: '';
		pointer-events: none;
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 1.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	.eyebrow span {
		width: 0.5rem;
		height: 0.5rem;
		flex: 0 0 auto;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--accent) 12%, transparent);
	}
	h1 {
		margin: 0;
		font-size: clamp(3.4rem, 7.2vw, 6.5rem);
		font-weight: 760;
		letter-spacing: -0.082em;
		line-height: 0.99;
	}
	h1 span {
		color: var(--accent);
	}
	.lede {
		max-width: 34rem;
		margin: 1.6rem 0 1.5rem;
		color: var(--muted);
		font-size: clamp(1.05rem, 1.55vw, 1.2rem);
		line-height: 1.75;
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		min-height: 3.15rem;
		padding: 0.8rem 1.15rem;
		border: 1px solid var(--accent);
		border-radius: 0.7rem;
		background: var(--accent);
		color: var(--button-text);
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 8px 18px color-mix(in srgb, var(--accent) 20%, transparent);
	}
	.button:hover {
		background: var(--accent-bright);
		color: var(--button-text);
		box-shadow: 0 11px 22px color-mix(in srgb, var(--accent) 26%, transparent);
		transform: translateY(-2px);
	}
	.button svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}
	.hero-caption {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 1.15rem 0 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.015em;
	}
	.hero-caption span {
		width: 0.2rem;
		height: 0.2rem;
		border-radius: 50%;
		background: var(--line);
	}
	.terminal {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 1rem;
		background: var(--panel);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		box-shadow: 0 2rem 5rem rgb(30 48 78 / 10%), 0 0.2rem 0.7rem rgb(30 48 78 / 5%);
		transform: rotate(1deg);
	}
	.terminal-bar {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		min-height: 3.3rem;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.7rem;
	}
	.terminal-dots {
		display: flex;
		gap: 0.32rem;
	}
	.terminal-dots i {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: #c5ceda;
	}
	.terminal-title {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.terminal-badge {
		margin-left: auto;
		padding: 0.25rem 0.45rem;
		border: 1px solid var(--line);
		border-radius: 99px;
		color: var(--accent);
		font-size: 0.55rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}
	.terminal-code {
		overflow-x: auto;
		padding: 1.25rem 1rem 1.35rem;
	}
	.terminal-code p {
		margin: 0;
		white-space: nowrap;
	}
	.terminal-code p + p {
		margin-top: 0.62rem;
	}
	.terminal-code p:nth-child(2),
	.terminal-code p:nth-child(4) {
		margin-bottom: 1rem;
	}
	.line-number {
		display: inline-block;
		width: 1.5rem;
		color: var(--line);
		user-select: none;
	}
	.prompt {
		margin-right: 0.35rem;
		color: var(--accent);
	}
	.comment {
		color: var(--comment);
	}
	.terminal-footer {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.8rem 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.63rem;
	}
	.terminal-footer span {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: #5b9b75;
		box-shadow: 0 0 0 0.2rem rgb(91 155 117 / 12%);
	}
	.recent {
		padding-top: 2.4rem;
		border-top: 1px solid var(--line);
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.4rem;
	}
	.section-heading .eyebrow {
		margin-bottom: 0.4rem;
	}
	h2 {
		margin: 0;
		font-size: clamp(1.55rem, 3vw, 2rem);
		letter-spacing: -0.04em;
	}
	.section-heading > a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 650;
		text-decoration: none;
	}
	.section-heading > a:hover {
		color: var(--accent-bright);
		gap: 0.65rem;
	}
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li {
		margin-top: 0.75rem;
	}
	.post-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.25rem 1.35rem;
		border: 1px solid var(--line);
		border-radius: 0.85rem;
		background: var(--panel);
		color: inherit;
		text-decoration: none;
	}
	.post-list a:hover {
		border-color: color-mix(in srgb, var(--accent) 42%, var(--line));
		box-shadow: 0 0.8rem 2rem rgb(30 48 78 / 7%);
		transform: translateY(-2px);
	}
	.post-list h3 {
		margin: 0 0 0.3rem;
		font-size: 1.08rem;
		letter-spacing: -0.02em;
	}
	.post-list p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.post-list time {
		flex: 0 0 auto;
		color: var(--muted);
		font-size: 0.78rem;
	}
	.empty {
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.85rem;
		background: var(--panel);
		color: var(--muted);
		font-size: 0.95rem;
	}
	.empty code {
		color: var(--accent);
	}
	@media (max-width: 760px) {
		.home {
			width: min(100% - 2.5rem, 74rem);
		}
		.intro {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
			min-height: auto;
			padding-bottom: 3.25rem;
		}
		.terminal {
			width: min(100%, 32rem);
			transform: none;
		}
	}
	@media (max-width: 600px) {
		.home {
			width: min(100% - 1.5rem, 68rem);
			padding-top: 3.25rem;
		}
		h1 {
			font-size: clamp(3.1rem, 12vw, 4.5rem);
		}
		.intro {
			gap: 1.75rem;
			padding-bottom: 2.5rem;
		}
		.section-heading {
			align-items: center;
		}
		.terminal {
			font-size: 0.68rem;
		}
		.terminal-code {
			padding-inline: 0.7rem;
		}
		.post-list a {
			align-items: flex-start;
			padding: 1rem;
		}
		.post-list time {
			padding-top: 0.25rem;
			font-size: 0.7rem;
		}
	}
	@media (max-width: 440px) {
		.post-list a {
			display: block;
		}
		.post-list time {
			display: inline-block;
			margin-top: 0.6rem;
		}
	}
</style>
