---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — cloud native field notes`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="intro">
				<div class="intro-copy">
					<p class="eyebrow"><span></span> CLOUD NATIVE FIELD NOTES</p>
					<h1>Less noise.<br /><span>More signal.</span></h1>
					<p class="lede">
						A practical notebook for Kubernetes, cloud native tools, and the lessons learned running
						systems in production.
					</p>
					<a class="button" href={`${SITE_BASE}blog/`}>
						Browse the notes <span aria-hidden="true">→</span>
					</a>
				</div>
				<div class="terminal" aria-label="Example Kubernetes command">
					<div class="terminal-bar">
						<span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span>quick-start.sh</span>
					</div>
					<div class="terminal-code">
						<p><span class="prompt">$</span> kubectl get pods -A</p>
						<p><span class="comment"># check the cluster at a glance</span></p>
						<p><span class="prompt">$</span> kubectl get nodes</p>
						<p><span class="comment"># inspect workload details</span></p>
						<p><span class="prompt">$</span> kubectl describe deploy api</p>
					</div>
				</div>
			</section>

			<section class="recent" aria-labelledby="recent-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">THE NOTEBOOK</p>
						<h2 id="recent-heading">Recent notes</h2>
					</div>
					<a href={`${SITE_BASE}blog/`}>All notes <span aria-hidden="true">→</span></a>
				</div>
				{posts.length > 0 ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`${SITE_BASE}blog/${post.id}/`}>
									<div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">
						The notebook is ready. Add a Markdown file in <code>src/content/blog/</code> to publish
						the first note.
					</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.home {
		width: min(100% - 2.5rem, 68rem);
		padding-top: clamp(3.5rem, 7vw, 6rem);
		padding-bottom: clamp(3rem, 7vw, 5rem);
	}
	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 5rem);
		min-height: 27rem;
		padding-bottom: clamp(3.5rem, 8vw, 6rem);
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}
	.eyebrow span {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--accent);
	}
	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 7.5vw, 6.7rem);
		letter-spacing: -0.075em;
		line-height: 0.98;
	}
	h1 span {
		color: var(--accent);
	}
	.lede {
		max-width: 36rem;
		margin: 1.4rem 0 1.6rem;
		color: var(--muted);
		font-size: clamp(1rem, 1.5vw, 1.15rem);
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		padding: 0.8rem 1.05rem;
		border: 1px solid var(--accent);
		border-radius: 0.4rem;
		background: var(--accent);
		color: var(--button-text);
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent-bright);
		color: var(--button-text);
	}
	.terminal {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 0.65rem;
		background: var(--panel);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		box-shadow: 0 1rem 2.5rem rgb(31 41 55 / 8%);
	}
	.terminal-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.7rem;
	}
	.terminal-dots {
		display: flex;
		gap: 0.3rem;
	}
	.terminal-dots i {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--line);
	}
	.terminal-code {
		overflow-x: auto;
		padding: 1.1rem 1.2rem;
	}
	.terminal-code p {
		margin: 0;
		white-space: nowrap;
	}
	.terminal-code p + p {
		margin-top: 0.45rem;
	}
	.terminal-code p:nth-child(2),
	.terminal-code p:nth-child(4) {
		margin-bottom: 0.8rem;
	}
	.prompt {
		margin-right: 0.4rem;
		color: var(--accent);
	}
	.comment {
		color: var(--comment);
	}
	.recent {
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.section-heading .eyebrow {
		margin-bottom: 0.4rem;
	}
	h2 {
		margin: 0;
		font-size: 1.75rem;
		letter-spacing: -0.04em;
	}
	.section-heading > a {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-decoration: none;
	}
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li {
		border-top: 1px solid var(--line);
	}
	.post-list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.4rem 0;
		color: inherit;
		text-decoration: none;
	}
	.post-list h3 {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
	}
	.post-list p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.post-list time {
		flex: 0 0 auto;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	.empty {
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.4rem;
		background: var(--panel);
		color: var(--muted);
		font-size: 0.95rem;
	}
	.empty code {
		color: var(--accent);
	}
	@media (max-width: 760px) {
		.home {
			width: min(100% - 2.5rem, 68rem);
		}
		.intro {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
			min-height: auto;
			padding-bottom: 3.5rem;
		}
		.terminal {
			width: min(100%, 32rem);
		}
		.post-list a {
			display: block;
		}
		.post-list time {
			display: inline-block;
			margin-top: 0.6rem;
		}
	}
	@media (max-width: 600px) {
		.home {
			width: min(100% - 1.5rem, 68rem);
			padding-top: 3rem;
		}
		h1 {
			font-size: clamp(3.1rem, 12vw, 4.5rem);
		}
		.intro {
			gap: 1.75rem;
			padding-bottom: 2.75rem;
		}
		.section-heading {
			align-items: center;
		}
	}
</style>
