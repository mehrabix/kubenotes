---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — cloud native field notes`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="intro">
				<p class="eyebrow"><span></span> CLOUD NATIVE FIELD NOTES</p>
				<h1>Less noise.<br /><span>More signal.</span></h1>
				<p class="lede">
					A practical notebook for Kubernetes, cloud native tools, and the lessons learned running
					systems in production.
				</p>
				<a class="button" href={`${SITE_BASE}blog/`}>Browse the notes <span aria-hidden="true">→</span></a>
				<div class="terminal" aria-label="Example Kubernetes command">
					<span class="prompt">$</span> kubectl get pods --all-namespaces
				</div>
			</section>

			<section class="recent" aria-labelledby="recent-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">THE NOTEBOOK</p>
						<h2 id="recent-heading">Recent notes</h2>
					</div>
					<a href={`${SITE_BASE}blog/`}>All notes <span aria-hidden="true">→</span></a>
				</div>
				{posts.length > 0 ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={`${SITE_BASE}blog/${post.id}/`}>
									<div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty">
						The notebook is ready. Add a Markdown file in <code>src/content/blog/</code> to publish
						the first note.
					</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.home {
		width: min(100% - 2.5rem, 68rem);
		padding-top: clamp(4rem, 10vw, 8rem);
		padding-bottom: 5rem;
	}
	.intro {
		position: relative;
		padding-bottom: clamp(4rem, 9vw, 7rem);
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}
	.eyebrow span {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--accent);
	}
	h1 {
		margin: 0;
		font-size: clamp(3.6rem, 10vw, 7.5rem);
		letter-spacing: -0.075em;
		line-height: 0.93;
	}
	h1 span {
		color: var(--accent);
	}
	.lede {
		max-width: 36rem;
		margin: 1.7rem 0 1.4rem;
		color: var(--muted);
		font-size: clamp(1.05rem, 2.5vw, 1.25rem);
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		padding: 0.8rem 1rem;
		border-radius: 0.35rem;
		background: var(--accent);
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		background: var(--accent-bright);
		color: var(--ink);
	}
	.terminal {
		position: absolute;
		right: 0;
		bottom: 7rem;
		padding: 1.2rem 1.4rem;
		border: 1px solid var(--line);
		border-radius: 0.45rem;
		background: var(--panel);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.82rem;
	}
	.prompt {
		margin-right: 0.55rem;
		color: var(--accent);
	}
	.recent {
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.section-heading .eyebrow {
		margin-bottom: 0.4rem;
	}
	h2 {
		margin: 0;
		font-size: 1.75rem;
		letter-spacing: -0.04em;
	}
	.section-heading > a {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-decoration: none;
	}
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-list li {
		border-top: 1px solid var(--line);
	}
	.post-list a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.4rem 0;
		color: inherit;
		text-decoration: none;
	}
	.post-list h3 {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
	}
	.post-list p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.post-list time {
		flex: 0 0 auto;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	.empty {
		padding: 1.25rem;
		border: 1px dashed var(--line);
		border-radius: 0.4rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.empty code {
		color: var(--accent);
	}
	@media (max-width: 760px) {
		.home {
			width: min(100% - 1.5rem, 68rem);
		}
		.terminal {
			display: none;
		}
		.post-list a {
			display: block;
		}
		.post-list time {
			display: inline-block;
			margin-top: 0.6rem;
		}
	}
</style>
