---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_BASE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="article-page">
			<article>
				<header class="article-heading">
					<a class="back-link" href={`${SITE_BASE}blog/`}>← All notes</a>
					<p class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && <> <span aria-hidden="true">·</span> Updated <FormattedDate date={updatedDate} /></>}
					</p>
					<h1>{title}</h1>
					<p class="description">{description}</p>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
<style>
	.article-page {
		width: min(100% - 2.5rem, 48rem);
		padding-top: clamp(3.5rem, 8vw, 6rem);
		padding-bottom: 6rem;
	}
	.article-heading {
		padding: clamp(1.25rem, 4vw, 2rem);
		border: 1px solid var(--line);
		border-radius: 1rem;
		background: var(--panel);
		box-shadow: 0 1rem 2.5rem rgb(30 48 78 / 5%);
	}
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--accent);
		font-size: 0.86rem;
		font-weight: 650;
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent-bright);
	}
	.date {
		margin: 2rem 0 0.8rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 4rem);
		font-weight: 760;
		letter-spacing: -0.075em;
		line-height: 1.05;
	}
	.description {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.75;
	}
	.prose {
		padding: 1.5rem clamp(0rem, 3vw, 0.75rem) 0;
		color: var(--ink);
		font-size: 1.03rem;
		line-height: 1.85;
	}
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin: 2.5rem 0 0.8rem;
		color: var(--ink);
		letter-spacing: -0.035em;
		line-height: 1.2;
	}
	.prose :global(h2) {
		font-size: 1.75rem;
	}
	.prose :global(h3) {
		font-size: 1.35rem;
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.25rem;
	}
	.prose :global(a) {
		color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}
	.prose :global(code) {
		padding: 0.14rem 0.38rem;
		border: 1px solid var(--code-line);
		border-radius: 0.32rem;
		background: var(--code-inline);
		color: var(--code-inline-text);
		font-family: var(--font-mono);
		font-size: 0.88em;
		text-decoration: none;
	}
	.prose :global(pre) {
		position: relative;
		overflow-x: auto;
		margin: 1.5rem 0;
		padding: 3.25rem 1.25rem 1.15rem;
		border: 1px solid var(--code-border);
		border-radius: 0.55rem;
		background: var(--code-background) !important;
		color: var(--code-text) !important;
		font-size: 0.85rem;
		line-height: 1.6;
		box-shadow: 0 0.75rem 1.8rem rgb(12 18 28 / 8%);
		tab-size: 2;
	}
	.prose :global(pre)::before {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		height: 2.35rem;
		border-bottom: 1px solid var(--code-border);
		background:
			radial-gradient(circle at 0.75rem 50%, #ef6a67 0 0.28rem, transparent 0.31rem),
			radial-gradient(circle at 1.35rem 50%, #e7b94f 0 0.28rem, transparent 0.31rem),
			radial-gradient(circle at 1.95rem 50%, #69be72 0 0.28rem, transparent 0.31rem),
			var(--code-inline);
		content: '';
	}
	.prose :global(pre)::after {
		position: absolute;
		top: 0.68rem;
		right: 0.85rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		content: 'CODE';
	}
	.prose :global(pre code) {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font-size: inherit;
		text-decoration: none;
	}
	.prose :global(pre code *) {
		text-decoration: none;
	}
	.prose :global(pre),
	.prose :global(pre code),
	.prose :global(pre code span) {
		text-decoration: none;
	}
	.prose :global(pre)::-webkit-scrollbar {
		height: 0.55rem;
	}
	.prose :global(pre)::-webkit-scrollbar-track {
		background: var(--code-background);
	}
	.prose :global(pre)::-webkit-scrollbar-thumb {
		border: 0.15rem solid var(--code-background);
		border-radius: 99px;
		background: var(--code-scrollbar);
	}
	.prose :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.8rem 1rem;
		border-left: 3px solid var(--accent);
		border-radius: 0 0.5rem 0.5rem 0;
		background: var(--soft);
		color: var(--muted);
	}
	.prose :global(hr) {
		margin: 2rem 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	@media (max-width: 600px) {
		.article-page {
			width: min(100% - 1.5rem, 48rem);
		}
	}
</style>
