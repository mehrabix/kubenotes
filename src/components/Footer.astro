---
const today = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<p>&copy; {today} kubenotes</p>
		<p class="footer-note">A small notebook for cloud native things.</p>
	</div>
</footer>
<style>
	footer {
		padding: 1.35rem 0;
		border-top: 1px solid var(--line);
		color: var(--muted);
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(100% - 2.5rem, 74rem);
		margin-inline: auto;
	}
	p {
		margin: 0;
		font-size: 0.85rem;
	}
	.footer-note {
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}
	@media (max-width: 600px) {
		.footer-inner {
			width: min(100% - 1.5rem, 74rem);
		}
		.footer-note {
			text-align: right;
		}
	}
</style>
