---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const siteBase = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const normalizePath = (path: string) => {
	const sitePath = path.startsWith(siteBase) ? `/${path.slice(siteBase.length)}` : path;
	return sitePath.replace(/\/$/, '') || '/';
};
const normalizedPath = normalizePath(Astro.url.pathname);
const normalizedHref = normalizePath(href ?? '/');
const isActive =
	normalizedHref === '/'
		? normalizedPath === '/'
		: normalizedPath === normalizedHref || normalizedPath.startsWith(`${normalizedHref}/`);
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
