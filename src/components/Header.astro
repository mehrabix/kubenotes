---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/"><span class="brand-mark">k</span>{SITE_TITLE}</a>
		<div class="nav-links">
			<HeaderLink href="/blog/">Notes</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<a class="rss-link" href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--line);
	}
	nav {
		width: min(100% - 2.5rem, 68rem);
		min-height: 4.5rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 1.15rem;
		font-weight: 750;
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		width: 1.8rem;
		aspect-ratio: 1;
		place-items: center;
		border-radius: 0.4rem;
		background: var(--accent);
		color: var(--ink);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: clamp(0.8rem, 3vw, 2rem);
	}
	.nav-links a {
		color: var(--muted);
		text-decoration: none;
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: var(--ink);
	}
	.rss-link {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	@media (max-width: 480px) {
		nav {
			width: min(100% - 1.5rem, 68rem);
		}
		.nav-links {
			gap: 0.75rem;
			font-size: 0.9rem;
		}
	}
</style>
